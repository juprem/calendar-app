generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "postgresql"
}

model day {
  id   Int      @id(map: "Day_pkey") @default(autoincrement())
  date DateTime @unique @db.Date
  rdv  rdv[]
}

model rdv {
  id               Int      @id @default(autoincrement())
  day_id           Int
  start_hour       String   @db.VarChar
  end_hour         String
  name             String   @db.VarChar
  rdv_type         String?  @db.VarChar
  is_confirmed     Boolean?
  additional_infos String?  @db.VarChar
  contact_id       Int?
  contact          contact? @relation(fields: [contact_id], references: [id], onUpdate: NoAction, map: "constraint_contact")
  day              day      @relation(fields: [day_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "constraint_day")

  @@index([day_id], map: "index_day")
}

model contact {
  id             Int      @id @default(autoincrement())
  firstname      String   @db.VarChar
  lastname       String   @db.VarChar
  email          String?  @db.VarChar
  phone_number   String?  @db.VarChar
  notes          String?
  birth_date     DateTime @default(now()) @db.Timestamp(6)
  birth_location String?  @db.VarChar
  address        String?  @db.VarChar
  civility       String?  @db.VarChar
  rdv            rdv[]

  @@unique([firstname, lastname], map: "fullname")
}
